# Qolaba AI API Credentials
# Erhalte deine Credentials von: https://qolaba.ai/dashboard
#
# WICHTIG:
# 1. Kopiere diese Datei: cp .env.example .env
# 2. Trage DEINE echten Credentials unten ein
# 3. Starte Container: docker compose up -d

# API Token (erforderlich)
# WICHTIG: Nur den Token OHNE "qol_live_" Prefix eintragen!
# Beispiel: Wenn dein Token "qol_live_abc123xyz" ist, trage nur "abc123xyz" ein
QOLABA_API_TOKEN=your_api_token_here

# Organization ID (erforderlich)
# WICHTIG: Nur die ID OHNE "org_" Prefix eintragen!
# Beispiel: Wenn deine Org-ID "org_abc123xyz" ist, trage nur "abc123xyz" ein
QOLABA_ORG_ID=your_organization_id_here

# Optional: MCP Transport Mode (stdio oder http)
# MCP_TRANSPORT=http

# Optional: HTTP Server Port
# PORT=8000

# Optional: Entwicklungsmodus (erlaubt Start ohne Credentials)
# ALLOW_NO_CREDENTIALS=false
