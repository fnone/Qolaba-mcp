# Qolaba AI API Credentials
# Erhalte deine Credentials von: https://qolaba.ai/dashboard

# API Token (erforderlich)
QOLABA_API_TOKEN=your_api_token_here

# Organization ID (erforderlich)
QOLABA_ORG_ID=your_organization_id_here

# Optional: MCP Transport Mode (stdio oder http)
# MCP_TRANSPORT=http

# Optional: HTTP Server Port
# PORT=8000

# Optional: Entwicklungsmodus (erlaubt Start ohne Credentials)
# ALLOW_NO_CREDENTIALS=false
